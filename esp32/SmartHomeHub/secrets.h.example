// secrets.h is listed in .gitignore and will not be committed to GitHub.

#pragma once

#define WIFI_SSID        "YourWiFiSSID"
#define WIFI_PASSWORD    "YourWiFiPassword"

// Firebase Console > Project settings > General > Web API Key
#define FIREBASE_API_KEY "YOUR_WEB_API_KEY"

// Realtime Database URL, with no trailing "/". Example:
// https://my-project-default-rtdb.europe-west1.firebasedatabase.app
#define FIREBASE_DB_URL  "https://YOUR-PROJECT-default-rtdb.firebaseio.com"

// Dedicated account for the device (Authentication > Users > Add user)
#define DEVICE_EMAIL     "esp32-device@example.com"
#define DEVICE_PASSWORD  "a-long-random-password"
